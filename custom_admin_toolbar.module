<?php

/**
 * @file
 * Custom admin toolbar module hooks.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Hook\Attribute\LegacyModuleImplementsAlter;
use Drupal\custom_admin_toolbar\Hook\CustomAdminToolbarHooks;

/**
 * Implements hook_module_implements_alter().
 *
 * Superseded by the Order::Last attribute on CustomAdminToolbarHooks; kept for
 * Drupal 10, which has no attribute-based ordering.
 *
 * @phpstan-param array<string, mixed> $implementations
 */
#[LegacyModuleImplementsAlter]
function custom_admin_toolbar_module_implements_alter(array &$implementations, string $hook): void {
  if ($hook == 'toolbar_alter') {
    // \Drupal::moduleHandler()->getImplementationInfo() iterates through
    // $implementations with a foreach loop which PHP iterates in the order
    // that the items were added, so to move an item to the end of the array,
    // we remove it and then add it.
    $group = $implementations['custom_admin_toolbar'];
    unset($implementations['custom_admin_toolbar']);
    $implementations['custom_admin_toolbar'] = $group;
  }
}

/**
 * Implements hook_toolbar_alter().
 *
 * @phpstan-param array<string, mixed> $items
 */
#[LegacyHook]
function custom_admin_toolbar_toolbar_alter(array &$items): void {
  \Drupal::service(CustomAdminToolbarHooks::class)->toolbarAlter($items);
}

/**
 * Adds toolbar-specific attributes to the menu link tree.
 *
 * @param \Drupal\Core\Menu\MenuLinkTreeElement[] $tree
 *   The menu link tree to manipulate.
 *
 * @return \Drupal\Core\Menu\MenuLinkTreeElement[]
 *   The manipulated menu link tree.
 */
function custom_admin_toolbar_tools_menu_navigation_links(array $tree): array {
  foreach ($tree as $element) {
    if ($element->subtree) {
      custom_admin_toolbar_tools_menu_navigation_links($element->subtree);
    }
    $link = $element->link;
    $definition = $link->getPluginDefinition();
    $element->options['attributes']['title'] = $link->getDescription();
    $element->options['attributes']['class'][] = 'toolbar-icon';
  }
  return $tree;
}
